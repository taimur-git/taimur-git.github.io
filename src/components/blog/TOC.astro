---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;
const filtered = headings.filter(h => h.depth <= 3);
const minDepth = filtered.length ? Math.min(...filtered.map(h => h.depth)) : 1;
---

{filtered.length > 2 && (
  <nav class="toc" aria-label="Table of contents">
    <p class="toc-heading mono">on this page</p>
    <ul>
      {filtered.map(h => (
        <li data-depth={h.depth - minDepth}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  li[data-depth="0"] > a {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    padding-left: 0;
  }

  li[data-depth="1"] > a {
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
    padding-left: 0.75rem;
  }

  li[data-depth="2"] > a {
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
    padding-left: 1.5rem;
  }

  li[data-depth="0"] > a:hover,
  li[data-depth="1"] > a:hover,
  li[data-depth="2"] > a:hover {
    color: var(--color-accent);
  }
</style>
