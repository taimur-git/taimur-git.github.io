---
import BaseLayout from './BaseLayout.astro';
import TagPill from '../components/blog/TagPill.astro';
import ReadingTime from '../components/blog/ReadingTime.astro';
import TOC from '../components/blog/TOC.astro';
import '../styles/blog.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  bnTitle?: string;
  date: Date;
  tags: string[];
  headings: Array<{ depth: number; slug: string; text: string }>;
  body?: string;
  bnBody?: string;
  hasBn?: boolean;
  excerpt?: string;
  newer?: { id: string; title: string } | null;
  older?: { id: string; title: string } | null;
  related?: { id: string; title: string }[];
}

const {
  title, bnTitle, date, tags, headings,
  body = '', bnBody = '', hasBn = false, excerpt,
  newer = null, older = null, related = [],
} = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---

<BaseLayout title={title} description={excerpt} ogType="article">
  <Fragment slot="head">
    {hasBn && (
      <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500&display=swap" rel="stylesheet" />
    )}
  </Fragment>
  <div class="blog-layout">
    <article class="blog-content">
      <div class="blog-top-row">
        <a href="/blog" class="blog-back">← back to writing</a>
        {hasBn && (
          <div class="lang-selector" role="group" aria-label="Post language">
            <button class="lang-pill" data-lang="en" aria-pressed="false">EN</button>
            <button class="lang-pill" data-lang="bn" aria-pressed="false">বাংলা</button>
          </div>
        )}
      </div>

      <h1 class="blog-post-title" id="title-en">{title}</h1>
      {hasBn && bnTitle && <h1 class="blog-post-title bn-font" id="title-bn" style="display:none">{bnTitle}</h1>}

      <div class="blog-post-meta">
        <span class="mono post-date">{formattedDate}</span>
        {body && <span id="reading-time-en"><ReadingTime body={body} /></span>}
        {hasBn && bnBody && <span id="reading-time-bn" style="display:none"><ReadingTime body={bnBody} /></span>}
        {tags.map(tag => <TagPill tag={tag} />)}
      </div>

      <div id="content-en">
        <slot name="en" />
      </div>
      {hasBn && (
        <div id="content-bn" class="bn-font" style="display:none">
          <slot name="bn" />
        </div>
      )}

      {related.length > 0 && (
        <aside class="post-related">
          <p class="post-related-label mono">related</p>
          {related.map(r => (
            <a href={`/blog/${r.id}`} class="post-related-item">{r.title}</a>
          ))}
        </aside>
      )}

      {(older || newer) && (
        <nav class="post-nav" aria-label="Post navigation">
          {older ? (
            <a href={`/blog/${older.id}`} class="post-nav-link">
              <span class="post-nav-dir mono">← older</span>
              <span class="post-nav-title">{older.title}</span>
            </a>
          ) : <span />}
          {newer ? (
            <a href={`/blog/${newer.id}`} class="post-nav-link post-nav-next">
              <span class="post-nav-dir mono">newer →</span>
              <span class="post-nav-title">{newer.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>
    <aside>
      <TOC headings={headings} />
    </aside>
  </div>
  <script is:inline>
  (function () {
    var stored = localStorage.getItem('blog-lang') || 'en';
    var hasBn = document.getElementById('content-bn') !== null;

    function applyLang(l) {
      var lang = (l === 'bn' && !hasBn) ? 'en' : l;

      var contentEn = document.getElementById('content-en');
      var contentBn = document.getElementById('content-bn');
      var titleEn = document.getElementById('title-en');
      var titleBn = document.getElementById('title-bn');
      var timeEn = document.getElementById('reading-time-en');
      var timeBn = document.getElementById('reading-time-bn');

      if (contentEn) contentEn.style.display = lang === 'en' ? '' : 'none';
      if (contentBn) contentBn.style.display = lang === 'bn' ? '' : 'none';
      if (titleEn) titleEn.style.display = lang === 'en' ? '' : 'none';
      if (titleBn) titleBn.style.display = lang === 'bn' ? '' : 'none';
      if (timeEn) timeEn.style.display = lang === 'en' ? '' : 'none';
      if (timeBn) timeBn.style.display = lang === 'bn' ? '' : 'none';

      document.documentElement.lang = lang === 'bn' ? 'bn' : 'en';
      localStorage.setItem('blog-lang', lang);

      document.querySelectorAll('.lang-pill').forEach(function (el) {
        el.classList.toggle('active', el.dataset.lang === lang);
        el.setAttribute('aria-pressed', String(el.dataset.lang === lang));
      });
    }

    applyLang(stored);

    document.querySelectorAll('.lang-pill:not([disabled])').forEach(function (el) {
      el.addEventListener('click', function () { applyLang(el.dataset.lang); });
    });
  })();
  </script>
  <script>
    // copy button on every code block
    document.querySelectorAll('.blog-content pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.className = 'code-copy-btn';
      btn.type = 'button';
      btn.textContent = 'copy';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = 'copied ✓';
          btn.classList.add('copied');
        } catch {
          btn.textContent = 'failed';
        }
        setTimeout(() => {
          btn.textContent = 'copy';
          btn.classList.remove('copied');
        }, 1600);
      });
      pre.appendChild(btn);
    });
  </script>
</BaseLayout>
