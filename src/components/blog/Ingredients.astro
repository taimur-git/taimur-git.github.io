---
interface Ingredient {
  amount: string;
  unit?: string;
  name: string;
  optional?: boolean;
}
interface Props {
  items: Ingredient[];
  title?: string;
  baseServings?: number;
}
const { items, title = 'Ingredients', baseServings = 2 } = Astro.props;
const id = `ing-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="ingredients" id={id} data-base-servings={baseServings}>
  <div class="ingredients-header">
    <p class="ingredients-heading">{title}</p>
    <div class="servings-stepper" role="group" aria-label="Adjust servings">
      <button class="step-btn" data-action="dec" aria-label="Fewer servings">−</button>
      <span class="servings-display">
        <span class="servings-label">Serves</span>
        <span class="servings-count" aria-live="polite">{baseServings}</span>
      </span>
      <button class="step-btn" data-action="inc" aria-label="More servings">+</button>
    </div>
  </div>
  <ul class="ingredients-list">
    {items.map((item) => (
      <li class={`ingredient${item.optional ? ' ingredient-optional' : ''}`}>
        <span
          class="ingredient-amount"
          data-base={`${item.amount}${item.unit ? ` ${item.unit}` : ''}`}
        >
          {item.amount}{item.unit ? ` ${item.unit}` : ''}
        </span>
        <span class="ingredient-name">{item.name}</span>
        {item.optional && <span class="ingredient-tag">optional</span>}
      </li>
    ))}
  </ul>
</div>

<style>
  .ingredients {
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: var(--space-6) 0;
    background: var(--color-surface-raised);
  }

  .ingredients-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-6);
    border-bottom: 0.5px solid var(--color-border);
    background: var(--color-surface);
  }

  .ingredients-heading {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }

  .servings-stepper {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .step-btn {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    border: 0.5px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: var(--font-size-base);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-base), color var(--transition-base);
    padding: 0;
  }

  .step-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .step-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .servings-display {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .servings-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
  }

  .servings-count {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    min-width: 1.5ch;
    text-align: center;
  }

  .ingredients-list {
    list-style: none;
    padding: 0 var(--space-6);
    margin: 0;
  }

  .ingredient {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 0.5px solid var(--color-border);
    font-size: var(--font-size-sm);
  }

  .ingredient:last-child { border-bottom: none; }

  .ingredient-optional { opacity: 0.5; }

  .ingredient-amount {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    min-width: 80px;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .ingredient-amount.updated {
    color: var(--color-accent);
  }

  .ingredient-name { flex: 1; color: var(--color-text); }
  .ingredient-optional .ingredient-name { font-style: italic; }

  .ingredient-tag {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    border: 0.5px solid var(--color-border-strong);
    padding: 1px 6px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }
</style>

<script>
  const FRACS: [number, string][] = [
    [1/8,'⅛'],[1/4,'¼'],[1/3,'⅓'],[3/8,'⅜'],[1/2,'½'],
    [5/8,'⅝'],[2/3,'⅔'],[3/4,'¾'],[7/8,'⅞'],
  ];

  const FRAC_VALUES: Record<string, number> = {};
  for (const [val, ch] of FRACS) FRAC_VALUES[ch] = val;

  /* handles "2", "1.5", "1/2", "1 1/2", "½", "1½", "1 ½" */
  function parseAmount(str: string): { num: number; sep: string; suffix: string } | null {
    const m = str.match(
      /^(\d+\s+\d+\/\d+|\d+\/\d+|\d+(?:\.\d+)?\s*[⅛¼⅓⅜½⅝⅔¾⅞]|[⅛¼⅓⅜½⅝⅔¾⅞]|\d+(?:\.\d+)?)(\s*)(.*)/
    );
    if (!m) return null;
    const raw = m[1];
    let num: number;
    const frac = raw.match(/[⅛¼⅓⅜½⅝⅔¾⅞]/);
    if (frac) {
      const whole = raw.match(/^\d+/);
      num = (whole ? parseInt(whole[0], 10) : 0) + FRAC_VALUES[frac[0]];
    } else if (raw.includes('/')) {
      const parts = raw.split(/[\s/]+/).map(Number);
      num = parts.length === 3 ? parts[0] + parts[1] / parts[2] : parts[0] / parts[1];
    } else {
      num = parseFloat(raw);
    }
    return { num, sep: m[2], suffix: m[3] };
  }

  function formatNum(n: number): string {
    const whole = Math.floor(n);
    const frac = n - whole;
    for (const [val, ch] of FRACS) {
      if (Math.abs(frac - val) < 0.05) {
        return whole > 0 ? `${whole} ${ch}` : ch;
      }
    }
    if (frac < 0.05) return whole.toString();
    if (n >= 10) return Math.round(n).toString();
    return parseFloat(n.toFixed(1)).toString();
  }

  document.querySelectorAll<HTMLElement>('.ingredients').forEach((wrap) => {
    const base = parseInt(wrap.dataset.baseServings ?? '2', 10);
    let current = base;
    const countEl = wrap.querySelector<HTMLElement>('.servings-count')!;
    const decBtn = wrap.querySelector<HTMLButtonElement>('[data-action="dec"]')!;
    const incBtn = wrap.querySelector<HTMLButtonElement>('[data-action="inc"]')!;
    const amounts = wrap.querySelectorAll<HTMLElement>('.ingredient-amount');

    function update() {
      countEl.textContent = String(current);
      decBtn.disabled = current <= 1;
      incBtn.disabled = current >= 20;

      amounts.forEach((el) => {
        const baseStr = el.dataset.base ?? '';
        const parsed = parseAmount(baseStr);
        if (!parsed) return;
        const scaled = (parsed.num / base) * current;
        const newText = formatNum(scaled) + parsed.sep + parsed.suffix;
        if (newText !== el.textContent?.trim()) {
          el.textContent = newText;
          el.classList.add('updated');
          setTimeout(() => el.classList.remove('updated'), 600);
        }
      });
    }

    decBtn.disabled = current <= 1;
    decBtn.addEventListener('click', () => { if (current > 1) { current--; update(); } });
    incBtn.addEventListener('click', () => { if (current < 20) { current++; update(); } });
  });
</script>
