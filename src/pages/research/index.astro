---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/blog.css';

const papers = (await getCollection('research'))
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Research">
  <div class="site-container" style="padding-top: var(--space-12);">
    <h1 style="font-size: var(--font-size-3xl); font-weight: var(--font-weight-medium); line-height: var(--line-height-tight); margin-bottom: var(--space-8);">research</h1>
    <div class="post-list">
      {papers.map(paper => {
        const doiUrl = paper.data.doi ? `https://doi.org/${paper.data.doi}` : undefined;
        return (
          <article class="post-card">
            <a href={`/research/${paper.id}`}>
              <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:var(--space-1);">
                <span class="mono post-date">{paper.data.venue} · {paper.data.year}</span>
                {paper.data.citations != null && paper.data.citations > 0 && (
                  <span class="research-cites">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z"/></svg>
                    {paper.data.citations} {paper.data.citations === 1 ? 'cite' : 'cites'}
                  </span>
                )}
              </div>
              <h2 class="post-title" style="margin-top:0;">{paper.data.title}</h2>
              <p class="post-excerpt">{paper.data.abstract.slice(0, 180)}…</p>
              <div class="post-tags">
                {paper.data.tags.map((tag: string) => (
                  <span class="tag-pill mono">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
