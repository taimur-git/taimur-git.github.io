---
interface Props {
  term: string;
}
const { term } = Astro.props;
const id = `tt-${Math.random().toString(36).slice(2, 8)}`;
---

<span class="tooltip-wrap">
  <span class="tooltip-trigger" tabindex="0" aria-describedby={id}>{term}</span>
  <span class="tooltip-card" role="tooltip" id={id}>
    <slot />
  </span>
</span>

<style>
  .tooltip-wrap {
    position: relative;
    display: inline;
  }

  .tooltip-trigger {
    border-bottom: 1px dotted var(--color-accent);
    color: var(--color-accent);
    cursor: help;
    border-radius: 2px;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .tooltip-wrap:hover .tooltip-trigger,
  .tooltip-wrap:focus-within .tooltip-trigger,
  .tooltip-wrap.open .tooltip-trigger {
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
    border-bottom-color: transparent;
  }

  .tooltip-card {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    background: var(--color-surface-raised);
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-body);
    z-index: 100;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    text-align: left;
  }

  .tooltip-wrap:hover .tooltip-card,
  .tooltip-wrap:focus-within .tooltip-card,
  .tooltip-wrap.open .tooltip-card {
    display: block;
  }

  /* Esc-dismissed (WCAG 1.4.13) — stays hidden until pointer/focus leaves */
  .tooltip-wrap.dismissed .tooltip-card {
    display: none;
  }
</style>

<script>
  document.querySelectorAll('.tooltip-wrap').forEach(function (wrap) {
    wrap.addEventListener('click', function (e) {
      e.stopPropagation();
      wrap.classList.toggle('open');
    });
    wrap.addEventListener('mouseleave', function () { wrap.classList.remove('dismissed'); });
    wrap.addEventListener('focusout',   function () { wrap.classList.remove('dismissed'); });
  });
  document.addEventListener('click', function () {
    document.querySelectorAll('.tooltip-wrap.open').forEach(function (w) {
      w.classList.remove('open');
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    document
      .querySelectorAll('.tooltip-wrap.open, .tooltip-wrap:hover, .tooltip-wrap:focus-within')
      .forEach(function (w) {
        w.classList.remove('open');
        w.classList.add('dismissed');
      });
  });
</script>
