---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDuration } from '../../lib/recipe/format';
import '../../styles/recipe.css';

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/* three facet axes, each filtering the same way. Course comes off the
   `category` field so it is never restated as a tag; tags are what the dish
   is made of; diet is the claim list. */
const courseOf = (r: (typeof recipes)[number]) =>
  r.data.category?.toLowerCase() ?? '';

const uniq = (xs: string[]) => [...new Set(xs)].filter(Boolean).sort();

const facetGroups = [
  { label: 'course', facets: uniq(recipes.map(courseOf)) },
  { label: 'uses', facets: uniq(recipes.flatMap((r) => r.data.tags)) },
  { label: 'diet', facets: uniq(recipes.flatMap((r) => r.data.diet)) },
].filter((g) => g.facets.length > 0);

const facetsOf = (r: (typeof recipes)[number]) =>
  [courseOf(r), ...r.data.tags, ...r.data.diet].filter(Boolean).join(',');
---

<BaseLayout title="Recipes" description="Recipes, written twice: as prose and as a dependency graph.">
  <div class="site-container" style="padding-top: var(--space-12); padding-bottom: var(--space-16);">
    <h1 style="font-size: var(--font-size-3xl); font-weight: var(--font-weight-medium); line-height: var(--line-height-tight);">recipes</h1>
    <p style="color: var(--color-text-muted); max-width: var(--max-width-prose); line-height: var(--line-height-body);">
      Here are my recipes I adapted from places. Sources are attached, exports support Paprika and OpenRecipe.
    </p>

    {facetGroups.length > 0 && (
      <>
      <button
        type="button"
        class="recipe-filter-toggle"
        id="recipe-filter-toggle"
        aria-controls="recipe-filters"
        aria-expanded="false"
        aria-label="Show filters"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg>
        <span class="mono">filters</span>
        <span class="recipe-filter-count mono" id="recipe-filter-count" hidden></span>
      </button>
      <div class="recipe-filters" id="recipe-filters" hidden>
        {facetGroups.map((group) => (
          <div class="recipe-filter-group">
            <span class="recipe-filter-label mono">{group.label}</span>
            {group.facets.map((facet) => (
              <button type="button" class="recipe-filter" data-facet={facet} aria-pressed="false">
                {facet}
              </button>
            ))}
          </div>
        ))}
      </div>
      </>
    )}

    {recipes.length === 0 ? (
      <p class="recipe-empty">Nothing here yet.</p>
    ) : (
      <div class="recipe-grid" id="recipe-grid">
        {recipes.map((recipe) => (
          <a href={`/recipes/${recipe.id}`} class="recipe-card-link" data-facets={facetsOf(recipe)}>
            {recipe.data.image && (
              <img class="recipe-card-thumb" src={recipe.data.image} alt="" loading="lazy" decoding="async" />
            )}
            <div class="recipe-card-body">
              <h2 class="recipe-card-title">{recipe.data.title}</h2>
              <p class="recipe-card-summary">{recipe.data.summary}</p>
              <div class="recipe-card-meta">
                <span>{recipe.data.yield}</span>
                <span>·</span>
                <span>{formatDuration(recipe.data.prep + recipe.data.cook)}</span>
                {recipe.data.heat !== 'none' && <><span>·</span><span>{recipe.data.heat}</span></>}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>

  <script is:inline>
    (function () {
      var active = null;
      var panel = document.getElementById('recipe-filters');
      var toggle = document.getElementById('recipe-filter-toggle');
      var count = document.getElementById('recipe-filter-count');

      function setOpen(open) {
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Hide filters' : 'Show filters');
      }

      function apply(facet) {
        active = facet;
        /* the panel can be shut, so the button carries the active facet */
        count.textContent = facet || '';
        count.hidden = !facet;
        toggle.classList.toggle('active', !!facet);
        document.querySelectorAll('#recipe-grid .recipe-card-link').forEach(function (card) {
          var facets = (card.dataset.facets || '').split(',');
          card.style.display = !facet || facets.includes(facet) ? '' : 'none';
        });
        document.querySelectorAll('#recipe-filters .recipe-filter').forEach(function (btn) {
          btn.setAttribute('aria-pressed', String(btn.dataset.facet === facet));
        });
      }

      function fromUrl() {
        return new URLSearchParams(window.location.search).get('tag');
      }

      apply(fromUrl());
      /* a shared ?tag= link lands with a filter on: open so it is visible */
      setOpen(!!fromUrl());

      toggle.addEventListener('click', function () {
        setOpen(panel.hidden);
      });

      document.querySelectorAll('#recipe-filters .recipe-filter').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = active === btn.dataset.facet ? null : btn.dataset.facet;
          history.pushState({}, '', next ? '?tag=' + encodeURIComponent(next) : window.location.pathname);
          apply(next);
        });
      });

      window.addEventListener('popstate', function () { apply(fromUrl()); });
    })();
  </script>
</BaseLayout>
