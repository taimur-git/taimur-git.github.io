---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;
const filtered = headings.filter(h => h.depth <= 3);
const minDepth = filtered.length ? Math.min(...filtered.map(h => h.depth)) : 1;
---

{filtered.length > 2 && (
  <nav class="toc" aria-label="Table of contents">
    <p class="toc-heading mono">on this page</p>
    <ul>
      {filtered.map(h => (
        <li data-depth={h.depth - minDepth}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  li[data-depth="0"] > a {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    padding-left: 0;
  }

  li[data-depth="1"] > a {
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
    padding-left: 0.75rem;
  }

  li[data-depth="2"] > a {
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
    padding-left: 1.5rem;
  }

  li > a:hover,
  li > a.toc-active {
    color: var(--color-accent);
  }

  li > a.toc-active {
    font-weight: var(--font-weight-medium);
  }
</style>

<script is:inline>
  (function () {
    var headings = Array.from(
      document.querySelectorAll('.blog-content h1[id], .blog-content h2[id], .blog-content h3[id]')
    );
    var links = Array.from(document.querySelectorAll('.toc a[href^="#"]'));

    if (!headings.length || !links.length) return;

    function getActiveId() {
      var scrollY = window.scrollY + 120;
      var active = headings[0].id;
      for (var i = 0; i < headings.length; i++) {
        if (headings[i].offsetTop <= scrollY) active = headings[i].id;
      }
      return active;
    }

    function update() {
      var active = getActiveId();
      links.forEach(function (link) {
        link.classList.toggle('toc-active', link.getAttribute('href') === '#' + active);
      });
    }

    var ticking = false;
    window.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(function () { update(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });

    update();
  })();
</script>
