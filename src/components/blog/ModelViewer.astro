---
interface Props {
  src: string;
  height?: string;
  camera?: 'perspective' | 'orthographic';
  angle?: 'front' | 'top' | 'side' | 'isometric' | 'three-quarter';
  zoom?: boolean;
  rotate?: boolean;
  pan?: boolean;
  autoRotate?: boolean;
  autoSpeed?: number;
  animation?: string;
  background?: string;
  border?: boolean;
  shadows?: boolean;
  flat?: boolean;
}

const {
  src,
  height = '400px',
  camera = 'perspective',
  angle = 'three-quarter',
  zoom = true,
  rotate = true,
  pan = false,
  autoRotate = false,
  autoSpeed = 1,
  animation,
  background = 'transparent',
  border = true,
  shadows = false,
  flat = true,
} = Astro.props;

const id = `mv-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="model-viewer"
  id={id}
  style={`height: ${height}${!border ? '; border-color: transparent' : ''}${background === 'transparent' ? '; background: transparent' : ''}`}
  data-src={src}
  data-camera={camera}
  data-angle={angle}
  data-zoom={String(zoom)}
  data-rotate={String(rotate)}
  data-pan={String(pan)}
  data-auto-rotate={String(autoRotate)}
  data-auto-speed={String(autoSpeed)}
  data-animation={animation ?? ''}
  data-background={background}
  data-shadows={String(shadows)}
  data-flat={String(flat)}
>
  <div class="mv-skeleton"></div>
  <canvas class="mv-canvas"></canvas>
</div>

<style>
  .model-viewer {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 0.5px solid var(--color-border);
    margin: var(--space-8) 0;
    background: var(--color-surface);
  }

  .mv-skeleton {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-surface) 25%,
      var(--color-border) 50%,
      var(--color-surface) 75%
    );
    background-size: 200% 100%;
    animation: mv-shimmer 1.4s infinite;
    border-radius: inherit;
  }

  .mv-skeleton.mv-error {
    background: none;
    animation: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  @keyframes mv-shimmer {
    0%   { background-position:  200% 0; }
    100% { background-position: -200% 0; }
  }

  /* three.js sets canvas style.width/height inline; display toggles via JS */
  .mv-canvas {
    display: none;
    position: absolute;
    inset: 0;
  }
</style>

<script>
  /* lazy init — the Three.js chunk (src/scripts/glb-viewer.ts) is only
     fetched when a viewer nears the viewport */
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        io.unobserve(entry.target);
        import('../../scripts/glb-viewer').then(({ initModelViewer }) => {
          initModelViewer(entry.target as HTMLElement);
        });
      }
    });
  }, { rootMargin: '200px' });

  document.querySelectorAll<HTMLElement>('.model-viewer').forEach((el) => io.observe(el));
</script>
