<div id="regression-sketch" class="manim-figure"></div>

<style>
  .manim-figure {
    margin: var(--space-8) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 0.5px solid var(--color-border);
    background: #0c0c0c;
  }
  .manim-figure canvas {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>

<script is:inline src="/libs/manim/lib/p5/p5.min.js"></script>
<script is:inline src="/libs/manim/manim.js"></script>
<script is:inline>
(function () {
  const W = 700, H = 400;
  const CX = 350, CY = 200;
  const STEP = 52;

  const sketch = function (s) {
    let grid;
    let pts;
    let dragging = -1;

    function toCanvas(mx, my) {
      return [CX + mx * STEP, CY - my * STEP];
    }

    function toMath(cx, cy) {
      return [(cx - CX) / STEP, (CY - cy) / STEP];
    }

    function regression() {
      let n = pts.length;
      let sx = 0, sy = 0, sxy = 0, sx2 = 0;
      for (let p of pts) {
        sx  += p[0]; sy  += p[1];
        sxy += p[0] * p[1];
        sx2 += p[0] * p[0];
      }
      let mx = sx / n, my = sy / n;
      let denom = sx2 - n * mx * mx;
      let beta = denom !== 0 ? (sxy - n * mx * my) / denom : 0;
      return [beta, my - beta * mx];
    }

    s.setup = function () {
      s.createCanvas(W, H).parent('regression-sketch');
      s.frameRate(30);

      pts = [
        [-5, -2.8], [-3.5, -1.6], [-2, -0.5],
        [0,   0.3], [1.5,  1.2],  [3,  1.9], [5, 2.8]
      ];

      // manim.js Grid — animates axes and grid lines in on load
      grid = new Grid(s, {
        centerX: CX, centerY: CY,
        spacing: STEP, stepX: STEP, stepY: STEP,
        top: 0, bottom: H, left: 0, right: W,
        start: 0,
      });
    };

    s.draw = function () {
      s.background(12);

      // animated coordinate grid from manim.js
      grid.showGrid();

      let [beta, b0] = regression();

      // regression line across full canvas
      let xL = (0   - CX) / STEP;
      let xR = (W   - CX) / STEP;
      s.stroke(77, 177, 255);
      s.strokeWeight(2.5);
      s.line(0, CY - (beta * xL + b0) * STEP, W, CY - (beta * xR + b0) * STEP);

      // residual lines
      s.strokeWeight(1);
      for (let p of pts) {
        let [cx, cy] = toCanvas(p[0], p[1]);
        let predY = CY - (beta * p[0] + b0) * STEP;
        s.stroke(50, 80, 130);
        s.line(cx, cy, cx, predY);
      }

      // data points
      for (let i = 0; i < pts.length; i++) {
        let [cx, cy] = toCanvas(pts[i][0], pts[i][1]);
        let hover = s.dist(s.mouseX, s.mouseY, cx, cy) < 12;

        s.strokeWeight(1.5);
        if (dragging === i) {
          s.fill(255, 210, 60); s.stroke(255, 210, 60);
        } else if (hover) {
          s.fill(255, 110, 130); s.stroke(255, 110, 130);
        } else {
          s.fill(255, 77, 97); s.stroke(255, 77, 97);
        }
        s.ellipse(cx, cy, 13, 13);
      }

      // equation label
      let sign = b0 >= 0 ? '+' : '-';
      s.noStroke();
      s.fill(200);
      s.textSize(13);
      s.textFont('monospace');
      s.textAlign(s.LEFT, s.TOP);
      s.text('ŷ = ' + beta.toFixed(2) + 'x ' + sign + ' ' + Math.abs(b0).toFixed(2), 14, 14);

      // hint
      s.fill(70);
      s.textSize(11);
      s.textAlign(s.RIGHT, s.BOTTOM);
      s.text('drag points', W - 12, H - 10);
    };

    s.mousePressed = function () {
      for (let i = 0; i < pts.length; i++) {
        let [cx, cy] = toCanvas(pts[i][0], pts[i][1]);
        if (s.dist(s.mouseX, s.mouseY, cx, cy) < 12) {
          dragging = i; return;
        }
      }
    };

    s.mouseDragged = function () {
      if (dragging >= 0) {
        pts[dragging] = toMath(s.mouseX, s.mouseY);
      }
    };

    s.mouseReleased = function () { dragging = -1; };
  };

  const observer = new IntersectionObserver(function (entries) {
    if (entries[0].isIntersecting) {
      new p5(sketch, 'regression-sketch');
      observer.disconnect();
    }
  }, { threshold: 0.1 });

  observer.observe(document.getElementById('regression-sketch'));
})();
</script>
