---
// Renders icon links for whichever socials exist in CV contact data.
// Add a handle in src/content/cv/index.mdx frontmatter and it appears.
import { getEntry } from 'astro:content';

const cv = await getEntry('cv', 'index');
const { github, linkedin } = cv?.data.contact ?? {};

const links = [
  github && {
    href: `https://${github}`,
    label: 'GitHub',
    icon: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22',
  },
  linkedin && {
    href: `https://${linkedin}`,
    label: 'LinkedIn',
    icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
  },
].filter(Boolean) as { href: string; label: string; icon: string }[];
---

{links.length > 0 && (
  <div class="social-links">
    {links.map(l => (
      <a href={l.href} aria-label={l.label} title={l.label} target="_blank" rel="noopener" class="social-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d={l.icon} />
        </svg>
      </a>
    ))}
  </div>
)}

<style>
  .social-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .social-link {
    color: var(--color-text-faint);
    display: flex;
    align-items: center;
  }

  .social-link:hover {
    color: var(--color-accent);
    opacity: 1;
  }
</style>
