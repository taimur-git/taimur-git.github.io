---
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}
interface Props {
  images: GalleryImage[];
  columns?: 2 | 3 | 4;
}
const { images, columns = 3 } = Astro.props;
const id = `gallery-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`gallery gallery-cols-${columns}`} id={id}>
  {images.map((img, i) => (
    <figure class="gallery-item">
      <button
        class="gallery-zoom-btn"
        data-gallery={id}
        data-index={String(i)}
        aria-label={`View image: ${img.alt}`}
      >
        <img src={img.src} alt={img.alt} class="gallery-img" loading="lazy" />
      </button>
      {img.caption && <figcaption class="gallery-caption">{img.caption}</figcaption>}
    </figure>
  ))}
</div>

<div class="gallery-lightbox" id={`${id}-lb`} role="dialog" aria-modal="true">
  <button class="gallery-close" aria-label="Close">✕</button>
  <button class="gallery-prev" aria-label="Previous">‹</button>
  <button class="gallery-next" aria-label="Next">›</button>
  <img src="" alt="" class="gallery-lb-img" />
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-8) 0;
  }

  .gallery-cols-2 { grid-template-columns: repeat(2, 1fr); }
  .gallery-cols-3 { grid-template-columns: repeat(3, 1fr); }
  .gallery-cols-4 { grid-template-columns: repeat(4, 1fr); }

  @media (max-width: 640px) {
    .gallery-cols-3,
    .gallery-cols-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 400px) {
    .gallery { grid-template-columns: 1fr; }
  }

  .gallery-item { margin: 0; }

  .gallery-zoom-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-md);
  }

  .gallery-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--color-border);
    transition: opacity var(--transition-base);
    display: block;
  }

  .gallery-zoom-btn:hover .gallery-img { opacity: 0.85; }

  .gallery-caption {
    margin-top: var(--space-1);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  .gallery-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.88);
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
  }

  .gallery-lightbox.open { display: flex; }

  .gallery-lb-img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: var(--radius-md);
    object-fit: contain;
    cursor: default;
  }

  .gallery-close,
  .gallery-prev,
  .gallery-next {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border: 0.5px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    border-radius: var(--radius-full);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-base);
  }

  .gallery-close:hover,
  .gallery-prev:hover,
  .gallery-next:hover { background: rgba(255, 255, 255, 0.2); }

  .gallery-close {
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    font-size: var(--font-size-sm);
  }

  .gallery-prev,
  .gallery-next {
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    font-size: 1.75rem;
    line-height: 1;
  }

  .gallery-prev { left: var(--space-4); }
  .gallery-next { right: var(--space-4); }
</style>

<script>
  interface LbState {
    _imgs?: { src: string; alt: string }[];
    _index?: number;
    _opener?: HTMLElement | null;
  }

  function closeGalleryLb(lb: HTMLElement & LbState) {
    lb.classList.remove('open');
    document.body.style.overflow = '';
    lb._opener?.focus();
    lb._opener = null;
  }

  function initGallery(galleryId: string) {
    const lb = document.getElementById(`${galleryId}-lb`) as (HTMLElement & LbState) | null;
    if (!lb || lb.dataset.init) return;
    lb.dataset.init = '1';

    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>(`[data-gallery="${galleryId}"]`)
    );
    const imgs = triggers.map((btn) => {
      const img = btn.querySelector('img')!;
      return { src: img.src, alt: img.alt };
    });
    const lbImg = lb.querySelector('.gallery-lb-img') as HTMLImageElement;

    function show(i: number) {
      lb!._index = i;
      lbImg.src = imgs[i].src;
      lbImg.alt = imgs[i].alt;
    }

    triggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        lb._imgs = imgs;
        lb._opener = btn;
        show(parseInt(btn.dataset.index!, 10));
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
        (lb.querySelector('.gallery-close') as HTMLElement).focus();
      });
    });

    lb.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === lb || t.classList.contains('gallery-close')) closeGalleryLb(lb);
    });

    lb.querySelector('.gallery-prev')!.addEventListener('click', (e) => {
      e.stopPropagation();
      show(((lb._index! - 1) + imgs.length) % imgs.length);
    });

    lb.querySelector('.gallery-next')!.addEventListener('click', (e) => {
      e.stopPropagation();
      show((lb._index! + 1) % imgs.length);
    });

    // focus trap: cycle between the three lightbox buttons
    lb.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const btns = Array.from(lb.querySelectorAll<HTMLElement>('button'));
      const i = btns.indexOf(document.activeElement as HTMLElement);
      e.preventDefault();
      const next = e.shiftKey
        ? (i - 1 + btns.length) % btns.length
        : (i + 1) % btns.length;
      btns[next].focus();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((btn) => {
    initGallery(btn.dataset.gallery!);
  });

  document.addEventListener('keydown', (e) => {
    const open = document.querySelector('.gallery-lightbox.open') as (HTMLElement & LbState) | null;
    if (!open) return;
    if (e.key === 'Escape') closeGalleryLb(open);
    if (e.key === 'ArrowLeft') (open.querySelector('.gallery-prev') as HTMLElement).click();
    if (e.key === 'ArrowRight') (open.querySelector('.gallery-next') as HTMLElement).click();
  });
</script>
