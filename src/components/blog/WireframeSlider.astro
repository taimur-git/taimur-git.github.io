---
interface Props {
  src: string;
  height?: string;
  angle?: 'front' | 'top' | 'side' | 'isometric' | 'three-quarter';
  zoom?: boolean;
  rotate?: boolean;
  pan?: boolean;
  autoRotate?: boolean;
  autoSpeed?: number;
  flat?: boolean;
  background?: string;
  border?: boolean;
  initialSplit?: number;
  wireColor?: string;
  wireMode?: 'edges' | 'tris';
  edgeThreshold?: number;
}

const {
  src,
  height       = '400px',
  angle        = 'three-quarter',
  zoom         = true,
  rotate       = true,
  pan          = false,
  autoRotate   = false,
  autoSpeed    = 1,
  flat         = true,
  background   = 'transparent',
  border       = true,
  initialSplit = 0.5,
  wireColor    = '#ffffff',
  wireMode     = 'edges',
  edgeThreshold = 15,
} = Astro.props;

const id = `ws-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="ws-wrap"
  id={id}
  style={[
    `height:${height}`,
    !border             ? 'border-color:transparent' : '',
    background === 'transparent' ? 'background:transparent' : `background:${background}`,
  ].filter(Boolean).join(';')}
  data-src={src}
  data-angle={angle}
  data-zoom={String(zoom)}
  data-rotate={String(rotate)}
  data-pan={String(pan)}
  data-auto-rotate={String(autoRotate)}
  data-auto-speed={String(autoSpeed)}
  data-flat={String(flat)}
  data-background={background}
  data-initial-split={String(initialSplit)}
  data-wire-color={wireColor}
  data-wire-mode={wireMode}
  data-edge-threshold={String(edgeThreshold)}
>
  <div class="ws-skeleton"></div>
  <canvas class="ws-canvas"></canvas>
  <div
    class="ws-divider"
    style={`left:${initialSplit * 100}%`}
    role="separator"
    aria-orientation="vertical"
    aria-label="Solid / wireframe split"
    aria-valuenow={Math.round(initialSplit * 100)}
    aria-valuemin="2"
    aria-valuemax="98"
    tabindex="0"
  ></div>
</div>

<style>
  .ws-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 0.5px solid var(--color-border);
    margin: var(--space-8) 0;
  }

  .ws-skeleton {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-surface) 25%,
      var(--color-border) 50%,
      var(--color-surface) 75%
    );
    background-size: 200% 100%;
    animation: ws-shimmer 1.4s infinite;
  }

  .ws-skeleton.ws-error {
    background: none;
    animation: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  @keyframes ws-shimmer {
    0%   { background-position:  200% 0; }
    100% { background-position: -200% 0; }
  }

  .ws-canvas {
    display: none;
    position: absolute;
    inset: 0;
  }

  .ws-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.7);
    transform: translateX(-0.5px);
    cursor: ew-resize;
    z-index: 2;
    display: none; /* shown after load */
  }

  /* widen hit area without widening the visual line */
  .ws-divider::before {
    content: '';
    position: absolute;
    inset: 0 -10px;
  }

  .ws-divider:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>

<script>
  /* lazy init: the Three.js chunk (src/scripts/glb-viewer.ts, shared with
     ModelViewer) is only fetched when a slider nears the viewport */
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        io.unobserve(entry.target);
        import('../../scripts/glb-viewer').then(({ initWireframeSlider }) => {
          initWireframeSlider(entry.target as HTMLElement);
        });
      }
    });
  }, { rootMargin: '200px' });

  document.querySelectorAll<HTMLElement>('.ws-wrap').forEach((el) => io.observe(el));
</script>
