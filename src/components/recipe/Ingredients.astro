---
import { renderQty } from '../../lib/recipe/format';
import type { RecipeIngredient } from '../../lib/recipe/schema';

interface Props {
  componentId: string;
  items: RecipeIngredient[];
  title?: string;
}
const { componentId, items, title } = Astro.props;
---

<div class="ingredients">
  {title && <p class="ingredients-heading">{title}</p>}
  <ul class="ingredients-list">
    {items.map((item) => (
      <li class={`ingredient${item.optional ? ' ingredient-optional' : ''}`}>
        <button
          type="button"
          class="ing-check"
          data-ing={`${componentId}:${item.id}`}
          aria-pressed="false"
        >
          <span class="ing-label">
            {item.qty !== undefined && (
              <span class="ingredient-amount" data-qty={item.qty} data-unit={item.unit ?? ''}>
                {renderQty(item.qty, item.unit)}
              </span>
            )}
            <span class="ingredient-name">
              {item.name}
              {item.note && <span class="ingredient-note">, {item.note}</span>}
            </span>
            {item.optional && <span class="ingredient-tag">optional</span>}
          </span>
        </button>
        {item.ref && (
          <a
            class="ing-ref"
            href={`#${item.ref}`}
            data-ref={item.ref}
            aria-label={`Jump to ${item.name}`}
          >↗</a>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .ingredients {
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: var(--space-4) 0 var(--space-6);
    background: var(--color-surface-raised);
  }

  .ingredients-heading {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
    padding: var(--space-3) var(--space-6);
    border-bottom: 0.5px solid var(--color-border);
    background: var(--color-surface);
  }

  .ingredients-list {
    list-style: none;
    padding: 0 var(--space-6);
    margin: 0;
  }

  .ingredient {
    border-bottom: 0.5px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .ingredient:last-child { border-bottom: none; }

  /* sibling of the toggle, never nested inside it: a link inside a button
     is invalid and the button swallows the click */
  .ing-ref {
    flex-shrink: 0;
    padding: var(--space-1) var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    line-height: 1;
    text-decoration: none;
  }

  .ing-ref:hover { color: var(--color-accent); opacity: 1; }

  .ing-check {
    display: block;
    flex: 1;
    min-width: 0;
    padding: var(--space-2) 0;
    background: none;
    border: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .ing-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
  }

  .ing-check[aria-pressed='true'] .ing-label {
    text-decoration: line-through;
    opacity: 0.4;
  }

  .ing-check:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .ingredient-optional { opacity: 0.55; }

  .ingredient-amount {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    min-width: 72px;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .ingredient-amount.updated { color: var(--color-accent); }

  .ingredient-name { flex: 1; color: var(--color-text); }
  .ingredient-note { color: var(--color-text-faint); }
  .ingredient-optional .ingredient-name { font-style: italic; }

  .ingredient-tag {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    border: 0.5px solid var(--color-border-strong);
    padding: 1px 6px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  /* an ingredient with no amount still needs the amount column's indent */
  .ing-label > .ingredient-name:first-child { margin-left: calc(72px + var(--space-3)); }

  @media (max-width: 480px) {
    .ing-label > .ingredient-name:first-child { margin-left: 0; }
    .ingredient-amount { min-width: 56px; }
  }
</style>
