---
interface Props {
  servings: number;
  unit?: string;
}
const { servings, unit = 'servings' } = Astro.props;
---

<div class="stepper" data-base-servings={servings}>
  <span class="stepper-label mono">scale</span>
  <div class="stepper-controls" role="group" aria-label="Adjust quantities">
    <button type="button" class="step-btn" data-step="-1" aria-label="Fewer servings">−</button>
    <span class="stepper-count">
      <span class="servings-count" aria-live="polite">{servings}</span>
      <span class="stepper-unit">{unit}</span>
    </span>
    <button type="button" class="step-btn" data-step="1" aria-label="More servings">+</button>
  </div>
  <button type="button" class="stepper-reset" hidden>reset</button>
</div>

<style>
  .stepper {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .stepper-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stepper-controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .step-btn {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-full);
    border: 0.5px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: var(--font-size-base);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: border-color var(--transition-base), color var(--transition-base);
  }

  .step-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .step-btn:disabled { opacity: 0.3; cursor: not-allowed; }

  .stepper-count {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .servings-count {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
    min-width: 2ch;
    text-align: center;
  }

  .stepper-unit { color: var(--color-text-faint); font-size: var(--font-size-xs); }

  .stepper-reset {
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    cursor: pointer;
    text-decoration: underline;
  }

  .stepper-reset:hover { color: var(--color-accent); }
</style>
