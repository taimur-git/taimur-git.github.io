---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/blog.css';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<BaseLayout title="Projects">
  <div class="site-container" style="padding-top: var(--space-12);">
    <h1 style="font-size: var(--font-size-3xl); font-weight: var(--font-weight-medium); line-height: var(--line-height-tight); margin-bottom: var(--space-8);">projects</h1>

    <section class="gh-section">
      <span class="mono gh-label">github activity · taimur-git</span>
      <div class="gh-chart-wrap" id="gh-chart">
        <div class="gh-skeleton" id="gh-skeleton"></div>
        <div class="gh-scroll" id="gh-scroll" hidden>
          <svg class="gh-svg" id="gh-svg" role="img" aria-label="GitHub contribution chart for taimur-git"></svg>
        </div>
        <div class="gh-footer" id="gh-footer" hidden>
          <span class="mono" id="gh-total"></span>
          <span class="gh-legend mono">
            less
            <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i>
            more
          </span>
        </div>
        <p class="gh-error mono" id="gh-error" hidden>couldn’t load github activity</p>
      </div>
    </section>

    {projects.length > 0 ? (
      <div class="proj-grid">
        {projects.map(project => (
          <article class="post-card proj-card">
            <div class="proj-body">
              <div class="proj-meta">
                <span class="mono post-date">{fmtDate(project.data.date)}</span>
                {project.data.featured && <span class="featured-badge mono">featured</span>}
              </div>
              <a href={`/projects/${project.id}`} class="proj-title-link">
                <h2 class="post-title">{project.data.title}</h2>
              </a>
              <p class="post-excerpt">{project.data.description}</p>
              <div class="post-tags">
                {project.data.tags.map((tag: string) => (
                  <span class="tag-pill mono">{tag}</span>
                ))}
              </div>
            </div>
            {(project.data.repo || project.data.demo) && (
              <div class="proj-links">
                {project.data.repo && (
                  <a href={project.data.repo} class="proj-btn mono" target="_blank" rel="noopener">repo ↗</a>
                )}
                {project.data.demo && (
                  <a href={project.data.demo} class="proj-btn mono" target="_blank" rel="noopener">demo ↗</a>
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="projects-empty mono">projects coming soon.</p>

    )}
  </div>
</BaseLayout>

<script>
  const USER = 'taimur-git';
  const CELL = 11;
  const GAP  = 3;
  const STEP = CELL + GAP;
  const TOP  = 18; // month label row
  const NS   = 'http://www.w3.org/2000/svg';
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  interface Day { date: string; count: number; level: number }

  const skeleton = document.getElementById('gh-skeleton')!;
  const scroll   = document.getElementById('gh-scroll')!;
  const svg      = document.getElementById('gh-svg')!;
  const footer   = document.getElementById('gh-footer')!;
  const totalEl  = document.getElementById('gh-total')!;
  const errorEl  = document.getElementById('gh-error')!;

  function render(days: Day[], total: number) {
    let col = 0;
    let prevRow = -1;
    let lastMonth = -1;

    for (const d of days) {
      const date = new Date(d.date + 'T00:00:00');
      const row = date.getDay(); // 0 = Sunday
      if (row <= prevRow) col++;
      prevRow = row;

      if (row === 0) {
        const m = date.getMonth();
        if (m !== lastMonth) {
          lastMonth = m;
          const t = document.createElementNS(NS, 'text');
          t.setAttribute('x', String(col * STEP));
          t.setAttribute('y', '10');
          t.style.fill = 'var(--color-text-faint)';
          t.style.fontSize = '9px';
          t.style.fontFamily = 'var(--font-mono)';
          t.textContent = MONTHS[m];
          svg.appendChild(t);
        }
      }

      const r = document.createElementNS(NS, 'rect');
      r.setAttribute('x', String(col * STEP));
      r.setAttribute('y', String(TOP + row * STEP));
      r.setAttribute('width', String(CELL));
      r.setAttribute('height', String(CELL));
      r.setAttribute('rx', '2');
      r.style.fill = `var(--gh-l${d.level})`;

      const title = document.createElementNS(NS, 'title');
      const nice = new Date(d.date + 'T00:00:00')
        .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      title.textContent = `${d.count} contribution${d.count === 1 ? '' : 's'} · ${nice}`;
      r.appendChild(title);
      svg.appendChild(r);
    }

    const width  = (col + 1) * STEP - GAP;
    const height = TOP + 7 * STEP - GAP;
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    svg.setAttribute('width',  String(width));
    svg.setAttribute('height', String(height));

    totalEl.textContent = `${total} contributions in the last year`;
    skeleton.hidden = true;
    scroll.hidden = false;
    footer.hidden = false;
    scroll.scrollLeft = scroll.scrollWidth; // most recent weeks visible first
  }

  fetch(`https://github-contributions-api.jogruber.de/v4/${USER}?y=last`)
    .then(res => {
      if (!res.ok) throw new Error(String(res.status));
      return res.json();
    })
    .then(data => render(data.contributions, data.total?.lastYear ?? 0))
    .catch(() => {
      skeleton.hidden = true;
      errorEl.hidden = false;
    });
</script>

<style>
  .gh-section { margin-bottom: var(--space-12); }

  .gh-label {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    margin-bottom: var(--space-3);
  }

  .gh-chart-wrap {
    /* contribution level scale, derived from theme accent */
    --gh-l0: var(--color-border);
    --gh-l1: color-mix(in srgb, var(--color-accent) 25%, var(--color-surface));
    --gh-l2: color-mix(in srgb, var(--color-accent) 50%, var(--color-surface));
    --gh-l3: color-mix(in srgb, var(--color-accent) 75%, var(--color-surface));
    --gh-l4: var(--color-accent);

    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-6);
    background: var(--color-surface);
  }

  .gh-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: var(--space-1);
  }

  .gh-svg {
    display: block;
    width: 100%;       /* scale up to fill the card on wide screens */
    min-width: 700px;  /* below this, keep cell size readable and scroll */
    height: auto;
  }

  .gh-skeleton {
    height: 113px;
    border-radius: var(--radius-md);
    background: linear-gradient(90deg, var(--color-surface) 25%, var(--color-border) 50%, var(--color-surface) 75%);
    background-size: 200% 100%;
    animation: gh-shimmer 1.4s infinite;
  }

  @keyframes gh-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .gh-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
  }

  .gh-legend {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
  }

  .gh-legend i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .gh-legend .l0 { background: var(--gh-l0); }
  .gh-legend .l1 { background: var(--gh-l1); }
  .gh-legend .l2 { background: var(--gh-l2); }
  .gh-legend .l3 { background: var(--gh-l3); }
  .gh-legend .l4 { background: var(--gh-l4); }

  .gh-error {
    margin: 0;
    padding: var(--space-8) 0;
    text-align: center;
    font-size: var(--font-size-sm);
    color: var(--color-text-faint);
  }

  /* ── Project grid ── */
  .proj-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  @media (max-width: 640px) {
    .proj-grid { grid-template-columns: 1fr; }
  }

  /* ── Project card ── */
  .proj-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .proj-body { flex: 1; }

  .proj-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-1);
  }

  .proj-title-link {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .proj-title-link:hover .post-title { color: var(--color-accent); }

  .proj-links {
    display: flex;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 0.5px solid var(--color-border);
  }

  .proj-btn {
    font-size: var(--font-size-xs);
    padding: 3px var(--space-3);
    border-radius: var(--radius-full);
    border: 0.5px solid var(--color-border-strong);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .proj-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
  }

  .featured-badge {
    font-size: var(--font-size-xs);
    color: var(--color-accent);
    border: 0.5px solid var(--color-accent);
    border-radius: var(--radius-full);
    padding: 1px var(--space-2);
  }

  .projects-empty {
    font-size: var(--font-size-sm);
    color: var(--color-text-faint);
    margin-top: var(--space-8);
  }
</style>
