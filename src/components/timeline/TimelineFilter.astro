---
const types = ['work', 'education', 'certification', 'research'];
---

<div class="timeline-filters" id="timeline-filters">
  <button class="filter-pill active" data-filter="all" aria-pressed="true">all</button>
  {types.map(t => (
    <button class="filter-pill" data-filter={t} aria-pressed="false">{t}</button>
  ))}
</div>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const entries = document.querySelectorAll<HTMLElement>('.timeline-entry');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      filters.forEach(b => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });

      entries.forEach(entry => {
        const show = filter === 'all' || entry.dataset.type === filter;
        entry.style.display = show ? '' : 'none';
      });
    });
  });
</script>
