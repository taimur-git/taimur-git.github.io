---
import Nav from '../components/shared/Nav.astro';
import Footer from '../components/shared/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  fullTitle?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Taimur Rahman | quality coordinator, researcher, developer.',
  fullTitle = false,
  ogType = 'website',
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | Taimur Rahman`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Taimur Rahman" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="Taimur Rahman — writing" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
