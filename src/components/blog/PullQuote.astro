---
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<blockquote class="pull-quote">
  <p class="pull-quote-text"><slot /></p>
  {cite && <cite class="pull-quote-cite">{cite}</cite>}
</blockquote>

<style>
  .pull-quote {
    margin: var(--space-8) calc(-1 * var(--space-4));
    padding: var(--space-6) var(--space-8);
    border: none;
    border-top: 2px solid var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    text-align: center;
    color: inherit;
  }

  .pull-quote-text {
    font-size: var(--font-size-xl);
    font-style: italic;
    line-height: var(--line-height-body);
    margin: 0;
    color: var(--color-text);
  }

  .pull-quote-cite {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-style: normal;
  }

  .pull-quote-cite::before { content: '- '; }

  @media (max-width: 640px) {
    .pull-quote { margin-inline: 0; padding-inline: var(--space-4); }
  }
</style>
