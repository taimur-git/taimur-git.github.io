---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  zoom?: boolean;
}
const { src, alt, caption, zoom = true } = Astro.props;
const id = `fig-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="post-figure">
  {zoom ? (
    <button class="figure-zoom-btn" data-lightbox={id} aria-label={`Enlarge image: ${alt}`}>
      <img src={src} alt={alt} class="figure-img zoomable" loading="lazy" />
    </button>
  ) : (
    <img src={src} alt={alt} class="figure-img" loading="lazy" />
  )}
  {caption && <figcaption class="figure-caption">{caption}</figcaption>}
</figure>

{zoom && (
  <div class="fig-lightbox" id={id} role="dialog" aria-modal="true" aria-label={alt}>
    <button class="fig-close" aria-label="Close">✕</button>
    <img src={src} alt={alt} class="fig-lightbox-img" />
  </div>
)}

<style>
  .post-figure {
    margin: var(--space-8) 0;
    text-align: center;
  }

  .figure-img {
    max-width: 100%;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--color-border);
    display: block;
    margin: 0 auto;
  }

  .figure-zoom-btn {
    display: block;
    margin: 0 auto;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-md);
  }

  .figure-img.zoomable {
    transition: opacity var(--transition-base);
  }

  .figure-zoom-btn:hover .figure-img { opacity: 0.9; }

  .figure-caption {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* lightbox */
  .fig-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
  }

  .fig-lightbox.open { display: flex; }

  .fig-lightbox-img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: var(--radius-md);
    object-fit: contain;
    cursor: default;
  }

  .fig-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: rgba(255, 255, 255, 0.1);
    border: 0.5px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    cursor: pointer;
    font-size: var(--font-size-sm);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-base);
  }

  .fig-close:hover { background: rgba(255, 255, 255, 0.2); }
</style>

<script>
  let lastTrigger: HTMLElement | null = null;

  function closeLightbox(lb: Element) {
    lb.classList.remove('open');
    document.body.style.overflow = '';
    lastTrigger?.focus();
    lastTrigger = null;
  }

  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const lb = document.getElementById(btn.dataset.lightbox!);
      if (!lb) return;
      lastTrigger = btn;
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
      lb.querySelector<HTMLElement>('.fig-close')?.focus();
    });
  });

  document.querySelectorAll('.fig-lightbox').forEach(function (lb) {
    lb.addEventListener('click', function (e) {
      const t = e.target as HTMLElement;
      if (t === lb || t.classList.contains('fig-close')) closeLightbox(lb);
    });
    // close button is the only focusable element — keep focus on it
    lb.addEventListener('keydown', function (e) {
      if ((e as KeyboardEvent).key === 'Tab') {
        e.preventDefault();
        (lb.querySelector('.fig-close') as HTMLElement)?.focus();
      }
    });
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.fig-lightbox.open').forEach(closeLightbox);
    }
  });
</script>
