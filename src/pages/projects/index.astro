---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/blog.css';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<BaseLayout title="Projects">
  <div class="site-container" style="padding-top: var(--space-12);">
    <h1 style="font-size: var(--font-size-3xl); font-weight: var(--font-weight-medium); line-height: var(--line-height-tight); margin-bottom: var(--space-8);">projects</h1>

    <section class="gh-section">
      <span class="mono gh-label">github activity · taimur-git</span>
      <div class="gh-chart-wrap">
        <div class="gh-skeleton" id="gh-skeleton"></div>
        <img id="gh-chart-img" alt="GitHub contribution chart for taimur-git" class="gh-chart gh-chart-hidden" />
      </div>
    </section>

    {projects.length > 0 ? (
      <div class="proj-grid">
        {projects.map(project => (
          <article class="post-card proj-card">
            <div class="proj-body">
              <div class="proj-meta">
                <span class="mono post-date">{fmtDate(project.data.date)}</span>
                {project.data.featured && <span class="featured-badge mono">featured</span>}
              </div>
              <a href={`/projects/${project.id}`} class="proj-title-link">
                <h2 class="post-title">{project.data.title}</h2>
              </a>
              <p class="post-excerpt">{project.data.description}</p>
              <div class="post-tags">
                {project.data.tags.map((tag: string) => (
                  <span class="tag-pill mono">{tag}</span>
                ))}
              </div>
            </div>
            {(project.data.repo || project.data.demo) && (
              <div class="proj-links">
                {project.data.repo && (
                  <a href={project.data.repo} class="proj-btn mono" target="_blank" rel="noopener">repo ↗</a>
                )}
                {project.data.demo && (
                  <a href={project.data.demo} class="proj-btn mono" target="_blank" rel="noopener">demo ↗</a>
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="projects-empty mono">projects coming soon.</p>

    )}
  </div>
</BaseLayout>

<script is:inline>
(function () {
  const img      = document.getElementById('gh-chart-img');
  const skeleton = document.getElementById('gh-skeleton');
  if (!img || !skeleton) return;

  const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  img.src = dark
    ? 'https://ghchart.rshah.org/3b82f6/taimur-git'
    : 'https://ghchart.rshah.org/2563eb/taimur-git';

  img.onload = function () {
    skeleton.style.display = 'none';
    img.classList.remove('gh-chart-hidden');
  };
  img.onerror = function () {
    skeleton.style.display = 'none';
    img.classList.remove('gh-chart-hidden');
  };
})();
</script>

<style>
  .gh-section { margin-bottom: var(--space-12); }

  .gh-label {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    margin-bottom: var(--space-3);
  }

  .gh-chart-wrap {
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-6);
    overflow: hidden;
    background: #fff;
  }

  @media (prefers-color-scheme: dark) {
    .gh-chart-wrap { background: #161b22; }
    .gh-chart { filter: invert(1) hue-rotate(215deg) saturate(1.3) brightness(0.9); }
  }

  .gh-skeleton {
    height: 112px;
    border-radius: var(--radius-md);
    background: linear-gradient(90deg, var(--color-surface) 25%, var(--color-border) 50%, var(--color-surface) 75%);
    background-size: 200% 100%;
    animation: gh-shimmer 1.4s infinite;
  }

  @keyframes gh-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .gh-chart { display: block; width: 100%; height: auto; }
  .gh-chart-hidden { display: none; }

  /* ── Project grid ── */
  .proj-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  @media (max-width: 640px) {
    .proj-grid { grid-template-columns: 1fr; }
  }

  /* ── Project card ── */
  .proj-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .proj-body { flex: 1; }

  .proj-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-1);
  }

  .proj-title-link {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .proj-title-link:hover .post-title { color: var(--color-accent); }

  .proj-links {
    display: flex;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 0.5px solid var(--color-border);
  }

  .proj-btn {
    font-size: var(--font-size-xs);
    padding: 3px var(--space-3);
    border-radius: var(--radius-full);
    border: 0.5px solid var(--color-border-strong);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .proj-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
  }

  .featured-badge {
    font-size: var(--font-size-xs);
    color: var(--color-accent);
    border: 0.5px solid var(--color-accent);
    border-radius: var(--radius-full);
    padding: 1px var(--space-2);
  }

  .projects-empty {
    font-size: var(--font-size-sm);
    color: var(--color-text-faint);
    margin-top: var(--space-8);
  }
</style>
